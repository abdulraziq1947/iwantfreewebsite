/**
 * Wrangler config — local-first. Do not deploy without approval.
 *
 * Workers:
 * - Top-level name: iwantfreewebsite (local / future production default)
 * - Staging Worker: iwfw-staging — select with CLOUDFLARE_ENV=staging at Vite build,
 *   then `wrangler deploy` (flattened config already has name iwfw-staging).
 *
 * Isolation: staging uses its own D1 database_id and Worker secrets.
 * Never point staging D1 at a production database UUID.
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "iwantfreewebsite",
  "compatibility_date": "2026-11-19",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./workers/app.ts",
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true,
  "vars": {
    "APP_URL": "http://localhost:5173",
    "APP_ENV": "development"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "iwfw-local",
      "database_id": "00000000-0000-4000-8000-000000000001",
      "migrations_dir": "../../packages/db/migrations"
    }
  ],
  "env": {
    "staging": {
      // Explicit Worker name — must match dashboard Worker "iwfw-staging".
      // Build with: CLOUDFLARE_ENV=staging pnpm run build
      // Then deploy: wrangler deploy  (do NOT use --env after a Vite build)
      "name": "iwfw-staging",
      "vars": {
        // After first workers.dev URL is known, update this var in the dashboard
        // or here (then rebuild). Must match the public origin for Better Auth.
        "APP_URL": "https://iwfw-staging.workers.dev",
        "APP_ENV": "staging"
      },
      "d1_databases": [
        {
          "binding": "DB",
          // Separate staging D1 (created manually) — never reuse a production UUID.
          "database_name": "iwfw-staging",
          "database_id": "6ff3f735-0dd5-4204-a778-b39b94dbfb19",
          "migrations_dir": "../../packages/db/migrations"
        }
      ]
    },
    "production": {
      // MUST set name explicitly. Without it, Wrangler suffixes the env and
      // flattens to "iwantfreewebsite-production", which would miss the existing
      // dashboard Worker "iwantfreewebsite".
      // Build with: CLOUDFLARE_ENV=production pnpm run build
      // Then deploy: wrangler deploy  (do NOT use --env after a Vite build)
      "name": "iwantfreewebsite",
      "vars": {
        "APP_URL": "https://iwantfreewebsite.com",
        "APP_ENV": "production"
      },
      "d1_databases": [
        {
          "binding": "DB",
          // Create a SEPARATE D1 named iwfw-production — never reuse staging UUID
          // 6ff3f735-0dd5-4204-a778-b39b94dbfb19.
          "database_name": "iwfw-production",
          "database_id": "REPLACE_WITH_PRODUCTION_D1_UUID",
          "migrations_dir": "../../packages/db/migrations"
        }
      ]
    }
  }
}
