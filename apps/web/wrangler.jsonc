/**
 * Wrangler config — local-first. Do not deploy without approval.
 *
 * Workers:
 * - Top-level name: iwantfreewebsite (local / future production default)
 * - Staging Worker: iwfw-staging — select with CLOUDFLARE_ENV=staging at Vite build,
 *   then `wrangler deploy` (flattened config already has name iwfw-staging).
 *
 * Isolation: staging uses its own D1 database_id and Worker secrets.
 * Never point staging D1 at a production database UUID.
 *
 * Stripe: STRIPE_PRICE_ID is a non-secret var. STRIPE_SECRET_KEY and
 * STRIPE_WEBHOOK_SECRET must be Wrangler/dashboard secrets — never commit.
 *
 * Resend: RESEND_API_KEY is a Wrangler/dashboard secret (production already
 * set). Optional RESEND_FROM_EMAIL defaults to accounts@iwantfreewebsite.com.
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "iwantfreewebsite",
  "compatibility_date": "2026-11-19",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./workers/app.ts",
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true,
  // Required for Workers Builds preview (`npx wrangler preview`). Empty object is valid.
  // Vite also copies this into build/server/wrangler.json; see workers-ci-prepare.mjs when
  // the Preview build_command is skipped and only `pnpm install` + wrangler preview run.
  "previews": {},
  "vars": {
    "APP_URL": "http://localhost:5173",
    "APP_ENV": "development"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "iwfw-local",
      "database_id": "00000000-0000-4000-8000-000000000001",
      "migrations_dir": "../../packages/db/migrations"
    }
  ],
  "env": {
    "staging": {
      "name": "iwfw-staging",
      "vars": {
        "APP_URL": "https://iwfw-staging.workers.dev",
        "APP_ENV": "staging",
        "STRIPE_PRICE_ID": "price_1UeFSMDyQBgE8h6RPqVRtzDo"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "iwfw-staging",
          "database_id": "6ff3f735-0dd5-4204-a778-b39b94dbfb19",
          "migrations_dir": "../../packages/db/migrations"
        }
      ]
    },
    "production": {
      "name": "iwantfreewebsite",
      "vars": {
        "APP_URL": "https://iwantfreewebsite.com",
        "APP_ENV": "production",
        "STRIPE_PRICE_ID": "price_1UeFSMDyQBgE8h6RPqVRtzDo"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "iwfw-production",
          "database_id": "634c4590-3ace-4416-a439-9c634827f4ba",
          "migrations_dir": "../../packages/db/migrations"
        }
      ]
    }
  }
}
