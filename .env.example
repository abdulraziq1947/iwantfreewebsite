# Copy to apps/web/.dev.vars for local Wrangler secrets (never commit .dev.vars).
# Placeholders only — do not put real production secrets here.

# Public / non-secret app config (also set as Wrangler vars per environment)
APP_URL=http://localhost:5173
APP_ENV=development

# Better Auth (generate a long random string for local use)
BETTER_AUTH_SECRET=replace-with-local-dev-secret-at-least-32-chars

# Optional: seed the first Platform Owner after signup (local/staging only)
# BOOTSTRAP_OWNER_EMAIL=you@example.com

# --- Stage D+ Stripe TEST only (see docs/STRIPE_TEST_SETUP.md) ---
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Canonical non-secret price id (also set in wrangler production vars):
# STRIPE_PRICE_ID=price_...
# Rank tracking stays disabled — do not enable Checkout for:
# STRIPE_PRICE_RANK_TRACKING_MONTHLY=

# --- Domain lookup (RDAP used by default; optional registrar check-only later) ---
# DOMAIN_LOOKUP_PROVIDER=rdap
# Never configure automatic domain purchase credentials.

# --- Stage C/D Resend (transactional + verification) ---
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=noreply@iwantfreewebsite.com

# MXROUTE_SERVER=
# MXROUTE_USERNAME=
# MXROUTE_API_KEY=
# DATAFORSEO_LOGIN=
# DATAFORSEO_PASSWORD=
# GBP_MANAGER_EMAIL=
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
